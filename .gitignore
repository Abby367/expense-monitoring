# Editor and OS cruft. Language-specific rules live in the per-project
# .gitignore files, which git applies relative to their own directory:
#   SAFC Frontend Expense Monitoring/.gitignore  (Node / Next.js)
#   SAFC Backend Expense Monitoring/.gitignore   (.NET)

.vscode/
.idea/
*.swp

.DS_Store
Thumbs.db
desktop.ini

# Local AI tooling. Claude Code's project config and subagent definitions live
# on the developer's machine, not in the shared repository.
/.claude/

# Claude Code / agent instructions, at any depth. These describe how to work on
# the project rather than being part of it, and stay on the developer's machine.
# AGENTS.md in the frontend is re-generated by `next dev`, so ignoring it also
# keeps it out of every diff.
CLAUDE.md
AGENTS.md
